# Written by the Claude Code engine when the mod loads; regenerated each load.
.claude-plugin/types/
# Local Claude Code settings for this folder.
.claude/settings.local.json
.DS_Store
# A local experiment, not part of the mod.
codex-client/

# The raw Desktop screen recording (440 MB) that demo/video/render.py cuts.
demo/raw/
# Made by demo/video/make_voice.py and render.py; rebuilt on each run.
demo/video/vo/
demo/video/music_bed.wav

# The demo videos and pictures live on the "media" branch, so that installing
# the mod (which downloads main) stays small. Your copies stay here;
# demo/video/publish_media.sh copies them to that branch.
demo/*.mp4
demo/*.png
demo/*.jpg
demo/stills/
demo/thread/*.mp4
demo/thread/*.jpg
